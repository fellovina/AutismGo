{
  "expo": {
    "name": "autism-go",
    "slug": "autism-go",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "autismgo",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.autismgo"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.autismgo",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AutismGo to access your photos so you can choose a profile picture.",
          "cameraPermission": "false",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow AutismGo to find nearby Safe Zones and share your location when you send an emergency alert."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow AutismGo to access your camera."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9e8d4de2-274f-420a-b1e7-344bea09691e"
      }
    }
  }
}
